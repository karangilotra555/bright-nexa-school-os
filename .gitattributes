# Precache revisions hash deployed bytes. Keep these assets identical on Windows
# and Linux instead of allowing core.autocrlf to rewrite the offline shell.
/index.html text eol=lf
/docs/index.html text eol=lf
/app-extracted/dist/index.html text eol=lf
school-workspace-*.js text eol=lf

# Every hashed frontend asset must use the same bytes in Windows and CI.
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.webmanifest text eol=lf
*.svg text eol=lf
